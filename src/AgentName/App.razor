@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="app" data-era="@EraInfo.Key(era)">
    <div class="bg bg-med" aria-hidden="true">
        <div class="med-halo"></div>
        <div class="med-initial">M</div>
        <div class="med-lines"></div>
        <div class="grain"></div>
    </div>
    <div class="bg bg-szoc" aria-hidden="true">
        <div class="rays"></div>
        <div class="star"></div>
        <div class="grain"></div>
    </div>
    <div class="bg bg-rv" aria-hidden="true">
        <div class="tt-bars"></div>
        <div class="tt-mosaic"></div>
        <div class="crt"></div>
    </div>
    <div class="bg bg-ner" aria-hidden="true">
        <svg class="eu-stars" viewBox="-60 -60 120 120">
            @for (var i = 0; i < 12; i++)
            {
                var a = i * Math.PI / 6;
                <use href="#ner-star" x="@((Math.Sin(a) * 45).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" y="@((-Math.Cos(a) * 45).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
            }
            <defs>
                <polygon id="ner-star" points="0,-6 1.76,-1.85 6.18,-1.85 2.6,0.7 3.53,5 0,2.6 -3.53,5 -2.6,0.7 -6.18,-1.85 -1.76,-1.85" />
            </defs>
        </svg>
        <div class="slogans">
            <p>NEMZETI · EGYÜTTMŰKÖDÉS · STADION · KISVASÚT · KILÁTÓ · ALAPÍTVÁNY ·</p>
            <p>KÖZBESZERZÉS · EGY AJÁNLAT · KUTATÓINTÉZET · SZÖKŐKÚT · TÉRKŐ ·</p>
            <p>KONZULTÁCIÓ · KÉK PLAKÁT · LED-IZZÓ · LOMBKORONA-SÉTÁNY · KASTÉLY ·</p>
        </div>
        <div class="ribbon"></div>
        <svg class="stadium" viewBox="0 0 1200 160" preserveAspectRatio="xMidYMax slice">
            <path d="M0 160V118c120-4 210-30 300-58 40-12 70-40 120-48h360c50 8 80 36 120 48 90 28 180 54 300 58v42z" />
            <path d="M330 52 420 4M870 52 780 4M420 4h360" fill="none" stroke-width="5" />
            <rect x="415" y="0" width="8" height="40" /><rect x="777" y="0" width="8" height="40" />
        </svg>
    </div>
    <div class="bg bg-nvvh" aria-hidden="true">
        <div class="nvvh-bars"></div>
        <div class="nvvh-seal">NVVH</div>
        <div class="nvvh-scan"></div>
        <div class="grain"></div>
    </div>

    <EraTabs Current="era" OnSelect="Select" />

    <main class="wrap">
        <section class="era era-med" hidden="@(era != Era.Kozepkor)">
            <KozepkorEra Input="input" ShareUrl="@Share(Era.Kozepkor)" />
        </section>
        <section class="era era-szoc" hidden="@(era != Era.Szoc)">
            <SocialistEra Input="input" ShareUrl="@Share(Era.Szoc)" />
        </section>
        <section class="era era-rv" hidden="@(era != Era.Rv)">
            <TransitionEra Input="input" ShareUrl="@Share(Era.Rv)" />
        </section>
        <section class="era era-ner" hidden="@(era != Era.Ner)">
            <NerEra Input="input" ShareUrl="@Share(Era.Ner)" />
        </section>
        <section class="era era-nvvh" hidden="@(era != Era.Nvvh)">
            <NvvhEra Input="input" ShareUrl="@Share(Era.Nvvh)" />
        </section>
    </main>
</div>

@code {
    private readonly Inputs input = new();
    private Era era;

    protected override void OnInitialized()
    {
        era = EraInfo.FromUri(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    private string Share(Era e) => $"{Nav.BaseUri}#{EraInfo.Hash(e)}";

    private async Task Select(Era next)
    {
        if (next == era) return;
        era = next;
        // Hash-only NavigateTo doesn't raise LocationChanged, so the state is set above;
        // LocationChanged still handles back/forward (popstate).
        Nav.NavigateTo("#" + EraInfo.Hash(next));
        await ScrollTop();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var next = EraInfo.FromUri(e.Location);
        if (next == era) return;
        era = next;
        StateHasChanged();
        await ScrollTop();
    }

    private async Task ScrollTop()
    {
        try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch (JSException) { }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
