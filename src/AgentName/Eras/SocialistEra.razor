<header class="hero">
    <p class="kicker">Belügyminisztérium · III. Főcsoportfőnökség</p>
    <h1>Mi lett volna az ügynökneved?</h1>
    <p class="lede">…a szocialista Magyarországon. Töltsd ki az adatlapot — nem kötelező, mi úgyis tudjuk.</p>
</header>

<form class="sheet form" @onsubmit="Generate" @onsubmit:preventDefault>
    <h2>Személyi adatlap <small>(kitöltése önkéntes)</small></h2>
    <div class="grid">
        <CommonFields Input="Input" />
        <label class="wide">
            <span>Kedvenc gyerekkori műsor</span>
            <select @bind="Input.Show">
                <option value="">— nem adom meg —</option>
                @foreach (var s in WordLists.Shows)
                {
                    <option value="@s.Label">@s.Label</option>
                }
            </select>
        </label>
    </div>
    <button type="submit" class="go">@(dossier is null ? "Akta lekérése" : "Másik akta lekérése")</button>
</form>

@if (dossier is not null)
{
    <article class="sheet dossier" @key="generation" aria-live="polite">
        <div class="stamp">Szigorúan titkos!</div>
        <p class="file-no">@dossier.Department · Dosszié: @dossier.FileNumber</p>
        <p class="label">Fedőnév</p>
        <h2 class="codename" style="--n:@(dossier.CodeName.Length + 2)"><span class="typed">„@dossier.CodeName”</span></h2>

        <dl>
            <dt>Alany</dt><dd>@dossier.Subject</dd>
            <dt>Minősítés</dt><dd>@dossier.Category</dd>
            <dt>Beszervezve</dt><dd>@dossier.RecruitYear, @dossier.Basis</dd>
            <dt>Tartótiszt</dt><dd>@dossier.Handler</dd>
            <dt>Találkozó</dt><dd>@dossier.MeetingPlace</dd>
            <dt>Célszemély(ek)</dt><dd>@dossier.Target</dd>
            <dt>Jelentések</dt><dd>@dossier.Reports db</dd>
            <dt>Jutalom</dt><dd>@dossier.Reward</dd>
            <dt>Értékelés</dt><dd>@dossier.Remark</dd>
        </dl>

        <div class="actions">
            <button type="button" class="ghost" @onclick="Generate">Újrasorsolás</button>
            <CopyButton Text="@($"Az ügynöknevem „{dossier.CodeName}” lett volna ({dossier.FileNumber}). Neked mi lett volna? {ShareUrl}")" />
        </div>
    </article>
}

<footer>
    Szatíra. Minden adat véletlenszerűen generált; bármilyen egyezés valós fedőnévvel vagy személlyel a véletlen műve.
    Semmi nem kerül elküldésre — minden a böngésződben fut.
</footer>

@code {
    [Parameter, EditorRequired] public Inputs Input { get; set; } = default!;
    [Parameter] public string ShareUrl { get; set; } = "";

    private Dossier? dossier;
    private int generation;

    private void Generate()
    {
        dossier = CodeNameGenerator.Generate(Input);
        generation++;
    }
}
